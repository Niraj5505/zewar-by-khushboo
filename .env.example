# ==========================================
# ZEWAR BY KHUSHBOO — ENVIRONMENT VARIABLES
# ==========================================

# Application Config
VITE_APP_NAME="Zewar by Khushboo"
VITE_APP_URL="http://localhost:5173"
PORT=5000
NODE_ENV="development"

# Database Configuration (MongoDB)
MONGODB_URI="mongodb+srv://user:password@cluster0.la5bw0i.mongodb.net/zewarbykhusboo"
DATABASE_URL="mongodb+srv://user:password@cluster0.la5bw0i.mongodb.net/zewarbykhusboo"

# Auth & Session Security
JWT_SECRET="your-ultra-secure-jwt-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="cookie-signing-secret"
COOKIE_SECURE=false

# Razorpay Payment Gateway (Server & Frontend)
VITE_RAZORPAY_KEY_ID="rzp_test_YourKeyHere"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# Transactional Email Provider (Resend / SendGrid / SMTP)
EMAIL_PROVIDER="Resend"
RESEND_API_KEY="re_YourApiKeyHere"
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="orders@zewarbykhushboo.com"
SMTP_PASS="smtp-password"
FROM_EMAIL="orders@zewarbykhushboo.com"
FROM_NAME="Zewar by Khushboo"

# Media & Image Storage (Cloudinary or AWS S3)
IMAGE_STORAGE_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# AWS S3 (Alternative)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="zewar-jewellery-assets"
